# =========================================================
# Backend Environment Configuration (Local Development)
# =========================================================

# Server Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
# - Default Homebrew PostgreSQL on Mac: postgresql://postgres:postgres@localhost:5432/cafe_db?schema=public
# - Or with your macOS username (if passwordless): postgresql://siva@localhost:5432/cafe_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafe_db?schema=public"

# Authentication Secret (any secure random string for signing JWT tokens)
JWT_SECRET="local_development_jwt_secret_key_cafe_system_12345"

# Frontend Origin URL (No trailing slash!)
FRONTEND_URL="http://localhost:5173"

# Comma-separated allowed CORS origins (optional, in addition to FRONTEND_URL)
CORS_ORIGINS="http://localhost:5173"

# Storage Driver (local or s3 - defaults to local in dev)
STORAGE_DRIVER=local

# ---------------------------------------------------------
# Optional / Third-Party Services (Not required for local dev)
# In development mode, OTPs and payments run with simulated fallbacks.
# ---------------------------------------------------------
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=TEST
# RESEND_API_KEY=
# MSG91_AUTHKEY=
