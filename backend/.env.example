# Tiffzy Backend Environment Example (do not put real secrets in this template)
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafesystem_dev
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
JWT_SECRET=replace-with-strong-jwt-secret

# Cashfree Configuration
CASHFREE_ENV=SANDBOX
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# TWM Pay (The Website Makers Pay) Configuration
# Configure real credentials strictly in deployment/.env (never commit real secrets)
TWM_MERCHANT_ID=
TWM_API_SECRET=
TWM_SIGNING_KEY=
TWM_URL=https://pay.thewebsitemakers.in
TWM_ENABLED=true
TWM_TIMEOUT_MS=15000
# Optional overrides if hosted behind reverse proxy / custom domains
# TWM_NOTIFY_URL=https://api.tiffzy.com/api/payments/twm/notify
# TWM_RETURN_URL=https://www.tiffzy.com/payment-status
