    {
      "name": "Auth Service",
      "item": [
        {
          "name": "POST /login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.token) pm.environment.set('jwt_token', json.token);",
                  "if (json && json.user && json.user.restaurantId) pm.environment.set('restaurant_id', String(json.user.restaurantId));",
                  "if (json && json.user && json.user.restaurant && json.user.restaurant.slug) pm.environment.set('restaurant_slug', json.user.restaurant.slug);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@cafeking.com\",\n  \"password\": \"owner123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Login and automatically store jwt_token in environment"
          }
        }
      ]
    },
