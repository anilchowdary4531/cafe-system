        {
          "name": "GET /super-admin/restaurants",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && Array.isArray(json.restaurants) && json.restaurants.length) {",
                  "  pm.environment.set('restaurant_id', String(json.restaurants[0].id));",
                  "  pm.environment.set('restaurant_slug', json.restaurants[0].slug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/super-admin/restaurants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "super-admin",
                "restaurants"
              ]
            },
            "description": "List all restaurants with owner, counts, and revenue."
          }
        },
        {
          "name": "POST /super-admin/restaurants",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.restaurant) {",
                  "  pm.environment.set('restaurant_id', String(json.restaurant.id));",
                  "  pm.environment.set('restaurant_slug', json.restaurant.slug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{new_restaurant_name}}\",\n  \"slug\": \"{{new_restaurant_slug}}\",\n  \"legalName\": \"Test Cafe Pvt Ltd\",\n  \"ownerName\": \"Test Cafe Owner\",\n  \"ownerEmail\": \"{{new_owner_email}}\",\n  \"ownerPhone\": \"9000000090\",\n  \"ownerPassword\": \"{{new_owner_password}}\",\n  \"city\": \"Hyderabad\",\n  \"state\": \"Telangana\",\n  \"pincode\": \"500001\",\n  \"gstNumber\": \"36ABCDE1234F1Z5\",\n  \"invoicePrefix\": \"TC\",\n  \"defaultTaxPercent\": 5,\n  \"taxEnabled\": true,\n  \"taxType\": \"EXCLUSIVE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/super-admin/restaurants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "super-admin",
                "restaurants"
              ]
            },
            "description": "Create a restaurant and OWNER user."
          }
        },
        {
          "name": "PATCH /super-admin/restaurants/:restaurantId/status",
