generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///////////////////////////////////////////////////////////
// RESTAURANT MASTER
///////////////////////////////////////////////////////////

model Restaurant {
  id Int @id @default(autoincrement())

  // BASIC INFO
  name      String
  legalName String? @map("legal_name")
  slug      String  @unique
  ownerName String? @map("owner_name")

  // CONTACT
  email String?
  phone String?
  upiId String? @map("upi_id")

  // BANK & SETTLEMENT PAYOUT DETAILS
  bankAccountNumber String? @map("bank_account_number")
  bankIfscCode      String? @map("bank_ifsc_code")
  bankAccountName   String? @map("bank_account_name")
  bankName          String? @map("bank_name")

  // ADDRESS
  addressLine1 String? @map("address_line1")
  city         String?
  state        String?
  country      String? @default("India")
  pincode      String? @map("postal_code")

  // GEO (optional - used for selecting nearest restaurant in UI)
  latitude  Float?
  longitude Float?

  // BUSINESS
  gstNumber String? @map("gst_number")
  logoUrl   String? @map("logo_url")
  bannerUrl String? @map("banner_url")
  brandColor String? @map("brand_color")
  faviconUrl String? @map("favicon_url")
  timezone  String? @default("Asia/Kolkata")
  currency  String? @default("INR")

  // TAX SETTINGS
  taxEnabled        Boolean @default(false) @map("tax_enabled")
  taxType           String  @default("EXCLUSIVE") @map("tax_type") // INCLUSIVE / EXCLUSIVE
  defaultTaxPercent Float   @default(5) @map("default_tax_percent")

  // SERVICE CHARGE
  serviceChargeEnabled Boolean @default(false) @map("service_charge_enabled")
  serviceChargePercent Float   @default(0) @map("service_charge_percent")

  // BILLING
  invoicePrefix     String? @default("INV") @map("invoice_prefix")
  nextInvoiceNumber Int     @default(1001) @map("next_invoice_number")

  // STATUS
  isActive Boolean @default(true) @map("is_active")

  // TIMESTAMPS
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // RELATIONS
  users         User[]
  staffAccesses StaffAccess[]
  customers     Customer[]
  menuItems     MenuItem[]
  orders        Order[]
  tables        DiningTable[]
  expenses      Expense[]
  branches      Branch[]
  payments      Payment[]
  inventory     InventoryStock[]
  payLaterAccounts     PayLaterAccount[]
  payLaterTransactions PayLaterTransaction[]
  customerNotifications CustomerNotification[]
  supplyCarts          SupplyCart[]
  supplyOrders         SupplyOrder[]

  @@map("restaurants")
}

///////////////////////////////////////////////////////////
// USERS
///////////////////////////////////////////////////////////

model User {
  id Int @id @default(autoincrement())

  name     String
  email    String  @unique
  phone    String?
  password String  @map("password_hash")

  // SUPER_ADMIN / OWNER / MANAGER / WAITER / CHEF / CASHIER
  role String @default("OWNER")
  designation String?
  sessionVersion Int @default(0) @map("session_version")

  restaurantId Int?         @map("restaurant_id")
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  staffAccess  StaffAccess?

  branchId Int?    @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([restaurantId, role, isActive])
  @@index([restaurantId, branchId])
  @@map("users")
}

model StaffAccess {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Role is restaurant-scoped (kept here so User can remain auth-only).
  role        String @default("STAFF")
  permissions Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@map("staff_accesses")
}

///////////////////////////////////////////////////////////
// MENU ITEMS
///////////////////////////////////////////////////////////

model MenuItem {
  id Int @id @default(autoincrement())

  name        String
  description String?
  category    String
  image       String? @map("image_url")

  price Float
  originalPrice Float? @map("original_price")
  discountPercent Float @default(0) @map("discount_percent")

  // ITEM LEVEL TAX OVERRIDE (optional)
  taxPercent  Float?  @map("tax_percent")
  isAvailable Boolean @default(true) @map("is_available")
  isFeatured  Boolean @default(false) @map("is_featured")

  // SOCIAL PROOF
  rating      Float @default(4.5)
  reviewCount Int   @default(0) @map("review_count")
  orderCount  Int   @default(0) @map("order_count")

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  inventory InventoryStock[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([restaurantId, category, isAvailable])
  @@map("menu_items")
}

///////////////////////////////////////////////////////////
// ORDERS
///////////////////////////////////////////////////////////

model Order {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  branchId Int?    @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  customerId Int?      @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ORDER INFO
  orderNo   String  @map("order_no")
  invoiceNo String? @map("invoice_no")
  invoiceS3Key String? @map("invoice_s3_key")
  invoiceS3Url String? @map("invoice_s3_url")

  // POS / ONLINE / QR
  orderSource String? @default("QR") @map("order_source")
  fulfillment String? @map("fulfillment")

  // ADMIN / STAFF / WAITER
  createdByRole   String? @map("created_by_role")
  createdByUserId Int?    @map("created_by_user_id")

  // WALK_IN / REGISTERED
  customerType String? @default("REGISTERED") @map("customer_type")

  customerName String? @map("customer_name")
  phone        String?
  email        String?

  tableNo String? @map("table_no")
  notes   String?
  deliveryAddress String? @map("delivery_address")
  deliveryLatitude Float? @map("delivery_latitude")
  deliveryLongitude Float? @map("delivery_longitude")

  // BILLING
  subtotal            Float
  taxAmount           Float @default(0) @map("tax_amount")
  serviceChargeAmount Float @default(0) @map("service_charge_amount")
  discountAmount      Float @default(0) @map("discount_amount")
  total               Float

  // PAYMENT
  paymentMode   String? @map("payment_mode") // CASH / CARD / UPI / ONLINE
  paymentStatus String  @default("PENDING") @map("payment_status")

  // STATUS
  status String @default("PLACED")
  // PLACED / ACCEPTED / PREPARING / READY / DELIVERED / CANCELLED

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  payments     Payment[]
  payLaterTransactions PayLaterTransaction[]

  @@unique([restaurantId, orderNo])
  @@index([restaurantId, customerId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, branchId, createdAt])
  @@index([phone, createdAt])
  @@map("orders")
}

///////////////////////////////////////////////////////////
// ORDER ITEMS
///////////////////////////////////////////////////////////

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId Int?   @map("menu_item_id")
  itemName   String @map("item_name")
  preparedByName String? @map("prepared_by_name")

  qty   Int   @map("quantity")
  price Float
  total Float

  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

model Customer {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name  String?
  phone String
  email String?

  rewardPoints Int @default(0) @map("reward_points")

  orders Order[]
  payLaterAccounts     PayLaterAccount[]
  payLaterTransactions PayLaterTransaction[]
  customerNotifications CustomerNotification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, phone])
  @@index([restaurantId, email])
  @@index([restaurantId, createdAt])
  @@map("customers")
}

model CustomerAccount {
  id Int @id @default(autoincrement())

  phone String?  @unique
  username String? @unique
  password String? @map("password_hash")
  googleId String? @unique @map("google_id")
  name  String?
  email String?
  avatarUrl String? @map("avatar_url")

  addresses CustomerAddress[]
  payments  Payment[]
  wallet    Wallet?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([phone, createdAt])
  @@index([username])
  @@index([email])
  @@index([googleId])
  @@map("customer_accounts")
}

model CustomerAddress {
  id Int @id @default(autoincrement())

  customerAccountId Int             @map("customer_account_id")
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  label String @default("Home")

  name  String?
  phone String?

  line1 String  @map("address_line1")
  line2 String? @map("address_line2")

  city       String?
  state      String?
  postalCode String? @map("postal_code")
  latitude   Float?
  longitude  Float?

  notes     String?
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([customerAccountId])
  @@index([customerAccountId, isDefault])
  @@map("customer_addresses")
}

model CustomerOtp {
  id Int @id @default(autoincrement())

  phone String @unique

  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")

  attempts   Int      @default(0)
  lastSentAt DateTime @map("last_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([phone, expiresAt])
  @@map("customer_otps")
}

// Generic OTP sessions for auth flows (staff/owner/super_admin and new unified /auth endpoints).
// Kept separate from CustomerOtp for backward compatibility with existing /customer/* OTP routes.
model AuthOtp {
  id Int @id @default(autoincrement())

  phone     String
  actorType String @map("actor_type")

  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")

  attempts   Int      @default(0)
  lastSentAt DateTime @map("last_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([phone, actorType], name: "phone_actorType")
  @@index([phone, actorType, expiresAt])
  @@map("auth_otps")
}

model OrderStatusEvent {
  id Int @id @default(autoincrement())

  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status          String
  source          String  @default("SYSTEM")
  changedByUserId Int?    @map("changed_by_user_id")
  changedByName   String? @map("changed_by_name")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("order_status_events")
}

///////////////////////////////////////////////////////////
// RESTAURANT TABLES
///////////////////////////////////////////////////////////

model DiningTable {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableNo String @map("table_no")
  seats   Int    @default(4)

  qrCodeUrl String? @map("qr_code_url")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, tableNo])
  @@index([restaurantId, isActive])
  @@map("dining_tables")
}

model Expense {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  title    String
  category String   @default("General")
  amount   Float
  notes    String?
  spentAt  DateTime @map("spent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([restaurantId, spentAt])
  @@index([restaurantId, createdAt])
  @@map("expenses")
}

///////////////////////////////////////////////////////////
// MULTI-BRANCH
///////////////////////////////////////////////////////////

model Branch {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name     String
  location String?

  latitude  Float?
  longitude Float?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  users  User[]
  orders Order[]

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
  @@map("branches")
}

///////////////////////////////////////////////////////////
// PAYMENTS
///////////////////////////////////////////////////////////

model Payment {
  id Int @id @default(autoincrement())

  cashfreeOrderId  String? @map("cashfree_order_id")
  paymentSessionId String? @map("payment_session_id")

  customerId   Int?             @map("customer_id")
  customer     CustomerAccount? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  restaurantId Int?             @map("restaurant_id")
  restaurant   Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  orderId      Int?             @map("order_id")
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  amount        Float   @default(0)
  amountSubunit Int?    @map("amount_subunit")
  currency      String  @default("INR")

  status        String  @default("PENDING")
  transactionId String? @map("transaction_id")
  paymentMethod String? @map("payment_method")
  method        String?
  provider      String? @default("CASHFREE")

  providerOrderId  String? @map("provider_order_id")
  providerMetadata Json?   @map("provider_metadata")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@index([cashfreeOrderId])
  @@index([paymentSessionId])
  @@map("payments")
}

///////////////////////////////////////////////////////////
// INVENTORY (RESTAURANT-SCOPED)
///////////////////////////////////////////////////////////

model InventoryStock {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItemId Int      @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  stockQuantity  Int @default(0) @map("stock_quantity")
  thresholdAlert Int @default(0) @map("threshold_alert")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, menuItemId])
  @@index([restaurantId])
  @@map("inventory_stocks")
}

model PayLaterAccount {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  totalBorrowed Float @default(0) @map("total_borrowed")
  totalPaid     Float @default(0) @map("total_paid")
  pendingBalance Float @default(0) @map("pending_balance")
  status        String @default("ACTIVE") // ACTIVE, SUSPENDED

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  transactions PayLaterTransaction[]

  @@unique([restaurantId, customerId])
  @@map("pay_later_accounts")
}

model PayLaterTransaction {
  id Int @id @default(autoincrement())

  accountId Int             @map("account_id")
  account   PayLaterAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId Int?   @map("order_id")
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  type   String // ORDER_CREDIT, MANUAL_CREDIT, ONLINE_REPAYMENT, OFFLINE_REPAYMENT, ADJUSTMENT
  amount Float
  description String?
  paymentReference String? @map("payment_reference")
  status String @default("SUCCESS") // SUCCESS, PENDING, FAILED

  createdBy String @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("pay_later_transactions")
}

model CustomerNotification {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   Int      @map("customer_id")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title        String
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("customer_notifications")
}

model Notification {
  id               Int       @id @default(autoincrement())
  recipientType    String    @map("recipient_type") // CUSTOMER | USER | RESTAURANT | DELIVERY_PARTNER
  recipientId      Int       @map("recipient_id")
  orderId          Int?      @map("order_id")
  restaurantId     Int?      @map("restaurant_id")
  notificationType String    @map("notification_type")
  title            String
  message          String
  data             Json?
  channel          String    @default("IN_APP")
  priority         String    @default("NORMAL")
  isRead           Boolean   @default(false) @map("is_read")
  idempotencyKey   String?   @unique @map("idempotency_key")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([recipientType, recipientId, isRead])
  @@index([orderId])
  @@index([restaurantId])
  @@map("notifications")
}

model DeviceToken {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  customerId  Int?     @map("customer_id")
  deviceToken String   @map("device_token")
  platform    String   @default("ANDROID") // ANDROID | IOS | WEB
  deviceId    String?  @map("device_id")
  isActive    Boolean  @default(true) @map("is_active")
  lastUsedAt  DateTime @default(now()) @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([deviceToken])
  @@index([userId, isActive])
  @@index([customerId, isActive])
  @@map("device_tokens")
}

model NotificationPreference {
  id              Int      @id @default(autoincrement())
  userId          Int?     @unique @map("user_id")
  customerId      Int?     @unique @map("customer_id")
  orderUpdates    Boolean  @default(true) @map("order_updates")
  paymentUpdates  Boolean  @default(true) @map("payment_updates")
  deliveryUpdates Boolean  @default(true) @map("delivery_updates")
  promotions      Boolean  @default(true)
  coupons         Boolean  @default(true)
  reviewReminders Boolean  @default(true) @map("review_reminders")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model GlobalCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  imageUrl  String?  @map("image_url")
  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("global_categories")
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String?
  imageUrl  String   @map("image_url")
  actionUrl String?  @map("action_url")
  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("banners")
}

///////////////////////////////////////////////////////////
// TIFFZY CUSTOMER WALLET SYSTEM
///////////////////////////////////////////////////////////

model Wallet {
  id                Int             @id @default(autoincrement())
  customerAccountId Int             @unique @map("customer_account_id")
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  currency          String          @default("INR")
  balance           Float           @default(0)
  status            String          @default("ACTIVE") // ACTIVE | BLOCKED | CLOSED

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  ledgers           WalletLedger[]
  topups            WalletTopup[]

  @@map("wallets")
}

model WalletLedger {
  id                Int          @id @default(autoincrement())
  walletId          Int          @map("wallet_id")
  wallet            Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)

  customerAccountId Int          @map("customer_account_id")

  type              String       // WALLET_TOPUP | ORDER_PAYMENT | REFUND | REVERSAL | ADJUSTMENT_CREDIT | ADJUSTMENT_DEBIT
  direction         String       // CREDIT | DEBIT
  amount            Float
  balanceBefore     Float        @map("balance_before")
  balanceAfter      Float        @map("balance_after")

  referenceType     String?      @map("reference_type") // ORDER | TOPUP | REFUND | ADMIN
  referenceId       String?      @map("reference_id")
  paymentId         Int?         @map("payment_id")
  orderId           Int?         @map("order_id")

  description       String
  idempotencyKey    String?      @unique @map("idempotency_key")
  status            String       @default("SUCCESS")
  metadata          Json?

  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([walletId, createdAt])
  @@index([customerAccountId, createdAt])
  @@index([orderId])
  @@map("wallet_ledgers")
}

model WalletTopup {
  id                Int             @id @default(autoincrement())
  walletId          Int             @map("wallet_id")
  wallet            Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  customerAccountId Int             @map("customer_account_id")
  topupTxnId        String          @unique @map("topup_txn_id")

  amount            Float
  currency          String          @default("INR")

  gateway           String          @default("CASHFREE")
  gatewayOrderId    String?         @map("gateway_order_id")
  gatewayPaymentId  String?         @map("gateway_payment_id")

  status            String          @default("PENDING") // PENDING | SUCCESS | FAILED | CANCELLED
  idempotencyKey    String?         @unique @map("idempotency_key")

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([walletId, createdAt])
  @@index([customerAccountId])
  @@map("wallet_topups")
}

///////////////////////////////////////////////////////////
// TIFFZY SUPPLY CHAIN MARKETPLACE MODELS
///////////////////////////////////////////////////////////

model Supplier {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  phone        String   @unique
  passwordHash String   @map("password_hash")
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED | BLOCKED | ACTIVE
  isVerified   Boolean  @default(false) @map("is_verified")
  sessionVersion Int    @default(0) @map("session_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  profile      SupplierProfile?
  addresses    SupplierAddress[]
  products     SupplyProduct[]
  orders       SupplyOrder[]
  settlements  SupplierSettlement[]
  reviews      SupplyReview[]

  @@index([status, createdAt])
  @@index([phone])
  @@map("suppliers")
}

model SupplierProfile {
  id               Int      @id @default(autoincrement())
  supplierId       Int      @unique @map("supplier_id")
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  businessName     String   @map("business_name")
  legalName        String?  @map("legal_name")
  gstin            String?  @unique
  fssaiLicense     String?  @map("fssai_license")
  logoUrl          String?  @map("logo_url")
  bannerUrl        String?  @map("banner_url")
  description      String?
  rating           Float    @default(4.8)
  reviewCount      Int      @default(0) @map("review_count")

  // BANK & SETTLEMENT PAYOUT DETAILS
  bankAccountNumber String? @map("bank_account_number")
  bankIfscCode      String? @map("bank_ifsc_code")
  bankAccountName   String? @map("bank_account_name")
  bankName          String? @map("bank_name")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("supplier_profiles")
}

model SupplierAddress {
  id          Int      @id @default(autoincrement())
  supplierId  Int      @map("supplier_id")
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  label       String   @default("Warehouse") // Main Warehouse, Branch Pick-up
  line1       String   @map("address_line1")
  line2       String?  @map("address_line2")
  city        String
  state       String
  pincode     String   @map("postal_code")
  country     String   @default("India")
  latitude    Float?
  longitude   Float?
  isPrimary   Boolean  @default(true) @map("is_primary")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([supplierId, isPrimary])
  @@map("supplier_addresses")
}

model SupplyCategory {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  slug      String          @unique
  imageUrl  String?         @map("image_url")
  isActive  Boolean         @default(true) @map("is_active")
  priority  Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at")

  products  SupplyProduct[]

  @@map("supply_categories")
}

model SupplyProduct {
  id           Int            @id @default(autoincrement())
  supplierId   Int            @map("supplier_id")
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  categoryId   Int?           @map("category_id")
  category     SupplyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name         String
  slug         String         @unique
  description  String?
  unit         String         @default("KG") // KG, GRAM, LITER, PACK, PIECE, BOX
  moq          Float          @default(1)    // Minimum Order Quantity
  availability Boolean        @default(true) @map("is_available")
  status       String         @default("PENDING") // PENDING | APPROVED | REJECTED | DISABLED
  isDeleted    Boolean        @default(false) @map("is_deleted")

  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")

  images       SupplyProductImage[]
  prices       SupplyPrice[]
  discounts    SupplyDiscount[]
  inventory    SupplyInventory?
  cartItems    SupplyCartItem[]
  orderItems   SupplyOrderItem[]
  reviews      SupplyReview[]

  @@index([supplierId, status, isDeleted])
  @@index([categoryId, availability, status])
  @@map("supply_products")
}

model SupplyProductImage {
  id        Int           @id @default(autoincrement())
  productId Int           @map("product_id")
  product   SupplyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageUrl  String        @map("image_url")
  priority  Int           @default(0)
  isPrimary Boolean       @default(false) @map("is_primary")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([productId, isPrimary])
  @@map("supply_product_images")
}

model SupplyPrice {
  id        Int           @id @default(autoincrement())
  productId Int           @map("product_id")
  product   SupplyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  basePrice Float         @map("base_price") // Cost before discount & tax
  taxPercent Float        @default(5.0) @map("tax_percent")
  currency  String        @default("INR")
  isActive  Boolean       @default(true) @map("is_active")

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([productId, isActive])
  @@map("supply_prices")
}

model SupplyDiscount {
  id           Int           @id @default(autoincrement())
  productId    Int           @map("product_id")
  product      SupplyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  type         String        @default("PERCENTAGE") // PERCENTAGE | FIXED
  value        Float         // e.g. 8.0 for 8% or 20.0 for ₹20
  startDate    DateTime?     @map("start_date")
  endDate      DateTime?     @map("end_date")
  isActive     Boolean       @default(true) @map("is_active")

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([productId, isActive])
  @@map("supply_discounts")
}

model SupplyInventory {
  id             Int           @id @default(autoincrement())
  productId      Int           @unique @map("product_id")
  product        SupplyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  totalStock     Float         @default(0) @map("total_stock")
  reservedStock  Float         @default(0) @map("reserved_stock")
  availableStock Float         @default(0) @map("available_stock") // available_stock = total_stock - reserved_stock
  lowStockAlert  Float         @default(10) @map("low_stock_alert")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  transactions   SupplyInventoryTransaction[]
  batches        SupplyInventoryBatch[]

  @@map("supply_inventories")
}

model SupplyInventoryTransaction {
  id            Int             @id @default(autoincrement())
  inventoryId   Int             @map("inventory_id")
  inventory     SupplyInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  type          String          // STOCK_ADD | STOCK_RESERVE | STOCK_RELEASE | STOCK_CONSUMED | STOCK_ADJUSTMENT
  quantity      Float
  balanceBefore Float           @map("balance_before")
  balanceAfter  Float           @map("balance_after")

  referenceType String?         @map("reference_type") // SUPPLY_ORDER | SUPPLIER_ADJUSTMENT | SYSTEM
  referenceId   String?         @map("reference_id")
  notes         String?

  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([inventoryId, createdAt])
  @@map("supply_inventory_transactions")
}

model SupplyInventoryBatch {
  id              Int             @id @default(autoincrement())
  inventoryId     Int             @map("inventory_id")
  inventory       SupplyInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  batchNumber     String          @map("batch_number")
  quantity        Float
  costPrice       Float?          @map("cost_price")
  manufactureDate DateTime?       @map("manufacture_date")
  expiryDate      DateTime?       @map("expiry_date")

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([inventoryId, batchNumber])
  @@map("supply_inventory_batches")
}

model SupplyCart {
  id           Int              @id @default(autoincrement())
  restaurantId Int              @unique @map("restaurant_id")
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at")

  items        SupplyCartItem[]

  @@map("supply_carts")
}

model SupplyCartItem {
  id         Int           @id @default(autoincrement())
  cartId     Int           @map("cart_id")
  cart       SupplyCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId  Int           @map("product_id")
  product    SupplyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity   Float
  unitPrice  Float         @map("unit_price")
  discount   Float         @default(0)
  finalPrice Float         @map("final_price")

  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at")

  @@unique([cartId, productId])
  @@map("supply_cart_items")
}

model SupplyOrder {
  id              Int        @id @default(autoincrement())
  orderNo         String     @unique @map("order_no")

  restaurantId    Int        @map("restaurant_id")
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  supplierId      Int        @map("supplier_id")
  supplier        Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // BILLING
  subtotal        Float
  discountAmount  Float      @default(0) @map("discount_amount")
  taxAmount       Float      @default(0) @map("tax_amount")
  deliveryFee     Float      @default(0) @map("delivery_fee")
  totalAmount     Float      @map("total_amount")

  // STATUS
  status          String     @default("PLACED")
  // PLACED / ACCEPTED / PROCESSING / READY / DISPATCHED / DELIVERED / COMPLETED / CANCELLED / REJECTED

  paymentStatus   String     @default("PENDING") @map("payment_status") // PENDING | PAID | FAILED | REFUNDED
  paymentMode     String?    @map("payment_mode") // ONLINE | CASH_ON_DELIVERY | CREDIT

  notes           String?
  deliveryAddress String?    @map("delivery_address")

  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at")

  items           SupplyOrderItem[]
  statusEvents    SupplyOrderStatusEvent[]
  payments        SupplyPayment[]
  refunds         SupplyRefund[]
  settlementItem  SupplierSettlementItem?

  @@index([restaurantId, createdAt])
  @@index([supplierId, status, createdAt])
  @@map("supply_orders")
}

model SupplyOrderItem {
  id         Int           @id @default(autoincrement())
  orderId    Int           @map("order_id")
  order      SupplyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId  Int?          @map("product_id")
  product    SupplyProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String       @map("product_name")
  unit        String
  quantity    Float
  unitPrice   Float        @map("unit_price")
  discount    Float        @default(0)
  totalPrice  Float        @map("total_price")

  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("supply_order_items")
}

model SupplyOrderStatusEvent {
  id          Int         @id @default(autoincrement())
  orderId     Int         @map("order_id")
  order       SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status      String
  notes       String?
  createdRole String?     @map("created_role")
  createdBy   String?     @map("created_by")

  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("supply_order_status_events")
}

model SupplyPayment {
  id               Int         @id @default(autoincrement())
  orderId          Int         @map("order_id")
  order            SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  gatewayTxnId     String?     @map("gateway_txn_id")
  paymentSessionId String?     @map("payment_session_id")
  amount           Float
  currency         String      @default("INR")
  status           String      @default("PENDING") // PENDING | SUCCESS | FAILED | CANCELLED
  provider         String      @default("CASHFREE")
  metadata         Json?

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([gatewayTxnId])
  @@map("supply_payments")
}

model SupplyRefund {
  id           Int         @id @default(autoincrement())
  orderId      Int         @map("order_id")
  order        SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  refundTxnId  String      @unique @map("refund_txn_id")
  amount       Float
  reason       String?
  status       String      @default("PENDING") // PENDING | COMPLETED | FAILED

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("supply_refunds")
}

model SupplierSettlement {
  id              Int                      @id @default(autoincrement())
  settlementNo    String                   @unique @map("settlement_no")

  supplierId      Int                      @map("supplier_id")
  supplier        Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  grossAmount     Float                    @map("gross_amount")
  commissionFee   Float                    @default(0) @map("commission_fee")
  taxDeductions   Float                    @default(0) @map("tax_deductions")
  netPayable      Float                    @map("net_payable")

  status          String                   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  payoutRef       String?                  @map("payout_ref")
  settledAt       DateTime?                @map("settled_at")

  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at")

  items           SupplierSettlementItem[]

  @@index([supplierId, status, createdAt])
  @@map("supplier_settlements")
}

model SupplierSettlementItem {
  id           Int                @id @default(autoincrement())
  settlementId Int                @map("settlement_id")
  settlement   SupplierSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  orderId      Int                @unique @map("order_id")
  order        SupplyOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderAmount  Float              @map("order_amount")
  commission   Float              @map("commission")
  netAmount    Float              @map("net_amount")

  createdAt    DateTime           @default(now()) @map("created_at")

  @@map("supplier_settlement_items")
}

model SupplyReview {
  id          Int           @id @default(autoincrement())
  supplierId  Int           @map("supplier_id")
  supplier    Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  productId   Int?          @map("product_id")
  product     SupplyProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  restaurantId Int          @map("restaurant_id")

  rating      Float         // 1.0 - 5.0
  comment     String?

  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([supplierId, rating])
  @@index([productId, rating])
  @@map("supply_reviews")
}

model SupplyAnalyticsEvent {
  id          Int      @id @default(autoincrement())
  eventType   String   @map("event_type") // PRODUCT_VIEW | CART_ADD | ORDER_PLACED | SUPPLIER_IMPRESSION
  actorType   String   @map("actor_type") // RESTAURANT | SUPPLIER | GUEST
  actorId     Int?     @map("actor_id")
  targetId    Int?     @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([actorType, actorId])
  @@map("supply_analytics_events")
}

