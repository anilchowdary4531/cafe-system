generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///////////////////////////////////////////////////////////
// RESTAURANT MASTER
///////////////////////////////////////////////////////////

model Restaurant {
  id Int @id @default(autoincrement())

  // BASIC INFO
  name      String
  legalName String? @map("legal_name")
  slug      String  @unique
  ownerName String? @map("owner_name")

  // CONTACT
  email String?
  phone String?
  upiId String? @map("upi_id")

  // BANK & SETTLEMENT PAYOUT DETAILS
  bankAccountNumber String? @map("bank_account_number")
  bankIfscCode      String? @map("bank_ifsc_code")
  bankAccountName   String? @map("bank_account_name")
  bankName          String? @map("bank_name")

  // ADDRESS
  addressLine1 String? @map("address_line1")
  city         String?
  state        String?
  country      String? @default("India")
  pincode      String? @map("postal_code")

  // GEO (optional - used for selecting nearest restaurant in UI)
  latitude  Float?
  longitude Float?

  // BUSINESS
  gstNumber String? @map("gst_number")
  logoUrl   String? @map("logo_url")
  bannerUrl String? @map("banner_url")
  brandColor String? @map("brand_color")
  faviconUrl String? @map("favicon_url")
  timezone  String? @default("Asia/Kolkata")
  currency  String? @default("INR")

  // TAX SETTINGS
  taxEnabled        Boolean @default(false) @map("tax_enabled")
  taxType           String  @default("EXCLUSIVE") @map("tax_type") // INCLUSIVE / EXCLUSIVE
  defaultTaxPercent Float   @default(5) @map("default_tax_percent")

  // SERVICE CHARGE
  serviceChargeEnabled Boolean @default(false) @map("service_charge_enabled")
  serviceChargePercent Float   @default(0) @map("service_charge_percent")

  // BILLING
  invoicePrefix     String? @default("INV") @map("invoice_prefix")
  nextInvoiceNumber Int     @default(1001) @map("next_invoice_number")
  nextKotNumber     Int     @default(101)  @map("next_kot_number")

  // STATUS
  isActive Boolean @default(true) @map("is_active")
  tobaccoApproved Boolean @default(false) @map("tobacco_approved")
  allowNegativeStock Boolean @default(true) @map("allow_negative_stock")

  // TIMESTAMPS
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // RELATIONS
  users         User[]
  staffAccesses StaffAccess[]
  customers     Customer[]
  menuItems     MenuItem[]
  orders        Order[]
  tables        DiningTable[]
  tableSessions TableSession[]
  expenses      Expense[]
  branches      Branch[]
  payments      Payment[]
  inventory     InventoryStock[]
  payLaterAccounts     PayLaterAccount[]
  payLaterTransactions PayLaterTransaction[]
  customerNotifications CustomerNotification[]
  supplyCarts          SupplyCart[]
  supplyOrders         SupplyOrder[]
  printers             Printer[]
  kitchenStations      KitchenStation[]
  kots                 KitchenOrderTicket[]
  tableOperationLogs   TableOperationLog[]
  billSplits           BillSplit[]
  reservations         Reservation[]
  rawMaterials         RawMaterial[]
  recipes              Recipe[]
  stockMovements       StockMovement[]
  cashierShifts        CashierShift[]
  cashMovements        CashMovement[]
  dayClosings          DayClosing[]
  promotions           Promotion[]
  loyaltyAccounts      LoyaltyAccount[]
  loyaltyTransactions  LoyaltyTransaction[]
  loyaltyConfig        LoyaltyConfig?

  @@map("restaurants")
}

///////////////////////////////////////////////////////////
// USERS
///////////////////////////////////////////////////////////

model User {
  id Int @id @default(autoincrement())

  name     String
  email    String  @unique
  phone    String?
  password String  @map("password_hash")

  // SUPER_ADMIN / OWNER / MANAGER / WAITER / CHEF / CASHIER
  role String @default("OWNER")
  designation String?
  sessionVersion Int @default(0) @map("session_version")

  restaurantId Int?         @map("restaurant_id")
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  staffAccess  StaffAccess?

  branchId Int?    @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true) @map("is_active")

  openedShifts       CashierShift[] @relation("OpenedShifts")
  closedShifts       CashierShift[] @relation("ClosedShifts")
  approvedShifts     CashierShift[] @relation("ApprovedShifts")
  closedDayClosings  DayClosing[]   @relation("ClosedDayClosings")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([restaurantId, role, isActive])
  @@index([restaurantId, branchId])
  @@map("users")
}

model StaffAccess {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Role is restaurant-scoped (kept here so User can remain auth-only).
  role        String @default("STAFF")
  permissions Json

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@map("staff_accesses")
}

///////////////////////////////////////////////////////////
// MENU ITEMS
///////////////////////////////////////////////////////////

model MenuItem {
  id Int @id @default(autoincrement())

  name        String
  description String?
  category    String
  image       String? @map("image_url")

  price Float
  originalPrice Float? @map("original_price")
  discountPercent Float @default(0) @map("discount_percent")

  // ITEM LEVEL TAX OVERRIDE (optional)
  taxPercent  Float?  @map("tax_percent")
  isAvailable Boolean @default(true) @map("is_available")
  isFeatured  Boolean @default(false) @map("is_featured")

  // SOCIAL PROOF
  rating      Float @default(4.5)
  reviewCount Int   @default(0) @map("review_count")
  orderCount  Int   @default(0) @map("order_count")

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  kitchenStationId Int?            @map("kitchen_station_id")
  kitchenStation   KitchenStation? @relation(fields: [kitchenStationId], references: [id], onDelete: SetNull)

  inventory InventoryStock[]
  variants  MenuItemVariant[]
  modifierGroups MenuItemModifierGroup[]
  recipes   Recipe[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([restaurantId, category, isAvailable])
  @@index([restaurantId, kitchenStationId])
  @@map("menu_items")
}

model MenuItemVariant {
  id Int @id @default(autoincrement())

  menuItemId Int      @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  name      String
  price     Float
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  recipes Recipe[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([menuItemId, isActive])
  @@map("menu_item_variants")
}

model MenuItemModifierGroup {
  id Int @id @default(autoincrement())

  menuItemId Int      @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  name       String
  isRequired Boolean @default(false) @map("is_required")
  minSelect  Int     @default(0) @map("min_select")
  maxSelect  Int     @default(1) @map("max_select")
  sortOrder  Int     @default(0) @map("sort_order")

  modifiers MenuItemModifier[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([menuItemId])
  @@map("menu_item_modifier_groups")
}

model MenuItemModifier {
  id Int @id @default(autoincrement())

  modifierGroupId Int                   @map("modifier_group_id")
  modifierGroup   MenuItemModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  name        String
  price       Float   @default(0)
  isAvailable Boolean @default(true) @map("is_available")
  sortOrder   Int     @default(0) @map("sort_order")

  recipes Recipe[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([modifierGroupId, isAvailable])
  @@map("menu_item_modifiers")
}

///////////////////////////////////////////////////////////
// ORDERS
///////////////////////////////////////////////////////////

model Order {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  branchId Int?    @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  customerId Int?      @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // ORDER INFO
  orderNo   String  @map("order_no")
  invoiceNo String? @map("invoice_no")
  invoiceS3Key String? @map("invoice_s3_key")
  invoiceS3Url String? @map("invoice_s3_url")

  // POS / ONLINE / QR
  orderSource String? @default("QR") @map("order_source")
  fulfillment String? @map("fulfillment")

  // ADMIN / STAFF / WAITER
  createdByRole   String? @map("created_by_role")
  createdByUserId Int?    @map("created_by_user_id")

  // WALK_IN / REGISTERED
  customerType String? @default("REGISTERED") @map("customer_type")

  customerName String? @map("customer_name")
  phone        String?
  email        String?

  tableNo String? @map("table_no")
  tableSessionId Int?          @map("table_session_id")
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  notes   String?
  deliveryAddress String? @map("delivery_address")
  deliveryLatitude Float? @map("delivery_latitude")
  deliveryLongitude Float? @map("delivery_longitude")

  // BILLING
  subtotal            Float
  taxAmount           Float @default(0) @map("tax_amount")
  serviceChargeAmount Float @default(0) @map("service_charge_amount")
  discountAmount      Float @default(0) @map("discount_amount")
  total               Float

  // PROMOTIONS & DISCOUNTS
  promotionId    Int?       @map("promotion_id")
  promotion      Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  couponCode     String?    @map("coupon_code")
  discountType   String?    @map("discount_type")
  discountReason String?    @map("discount_reason")

  // LOYALTY REWARDS SNAPSHOT
  loyaltyPointsRedeemed Int   @default(0) @map("loyalty_points_redeemed")
  loyaltyDiscountAmount Float @default(0) @map("loyalty_discount_amount")
  loyaltyPointsEarned   Int   @default(0) @map("loyalty_points_earned")

  // PAYMENT
  paymentMode   String? @map("payment_mode") // CASH / CARD / UPI / ONLINE
  paymentStatus String  @default("PENDING") @map("payment_status")

  // STATUS
  status String @default("PLACED")
  // PLACED / ACCEPTED / PREPARING / READY / DELIVERED / CANCELLED

  clientOperationId String? @unique @map("client_operation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  payments     Payment[]
  payLaterTransactions PayLaterTransaction[]
  kots         KitchenOrderTicket[]
  billSplits   BillSplit[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([restaurantId, orderNo])
  @@index([restaurantId, customerId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, tableSessionId])
  @@index([restaurantId, branchId, createdAt])
  @@index([phone, createdAt])
  @@map("orders")
}

///////////////////////////////////////////////////////////
// ORDER ITEMS
///////////////////////////////////////////////////////////

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId Int?   @map("menu_item_id")
  itemName   String @map("item_name")
  preparedByName String? @map("prepared_by_name")

  // SNAPSHOT FIELDS FOR VARIANTS, MODIFIERS & NOTES
  variantId         Int?    @map("variant_id")
  variantName       String? @map("variant_name")
  variantPrice      Float?  @map("variant_price")
  selectedModifiers Json?   @map("selected_modifiers")
  notes             String?

  qty   Int   @map("quantity")
  price Float
  total Float

  createdAt DateTime @default(now()) @map("created_at")

  billSplitItems BillSplitItem[]
  stockMovements StockMovement[]

  @@map("order_items")
}

model Customer {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name  String?
  phone String
  email String?

  notes       String?
  status      String    @default("ACTIVE")
  tags        String?
  dateOfBirth DateTime? @map("date_of_birth")
  gender      String?

  rewardPoints Int @default(0) @map("reward_points")

  orders                Order[]
  payLaterAccounts      PayLaterAccount[]
  payLaterTransactions  PayLaterTransaction[]
  customerNotifications CustomerNotification[]
  reservations          Reservation[]
  addresses             CustomerAddress[]
  loyaltyAccounts       LoyaltyAccount[]
  loyaltyTransactions   LoyaltyTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, phone])
  @@index([restaurantId, phone])
  @@index([restaurantId, name])
  @@index([restaurantId, email])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@map("customers")
}

model CustomerAccount {
  id Int @id @default(autoincrement())

  phone String?  @unique
  username String? @unique
  password String? @map("password_hash")
  googleId String? @unique @map("google_id")
  name  String?
  email String?
  avatarUrl String? @map("avatar_url")

  addresses CustomerAddress[]
  payments  Payment[]
  wallet    Wallet?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([phone, createdAt])
  @@index([username])
  @@index([email])
  @@index([googleId])
  @@map("customer_accounts")
}

model CustomerAddress {
  id Int @id @default(autoincrement())

  customerAccountId Int?             @map("customer_account_id")
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  customerId Int?      @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label String @default("Home")

  name  String?
  phone String?

  line1 String  @map("address_line1")
  line2 String? @map("address_line2")

  city       String?
  state      String?
  postalCode String? @map("postal_code")
  latitude   Float?
  longitude  Float?

  notes     String?
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([customerAccountId])
  @@index([customerAccountId, isDefault])
  @@index([customerId])
  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

model CustomerOtp {
  id Int @id @default(autoincrement())

  phone String @unique

  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")

  attempts   Int      @default(0)
  lastSentAt DateTime @map("last_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([phone, expiresAt])
  @@map("customer_otps")
}

// Generic OTP sessions for auth flows (staff/owner/super_admin and new unified /auth endpoints).
// Kept separate from CustomerOtp for backward compatibility with existing /customer/* OTP routes.
model AuthOtp {
  id Int @id @default(autoincrement())

  phone     String
  actorType String @map("actor_type")

  otpHash   String   @map("otp_hash")
  expiresAt DateTime @map("expires_at")

  attempts   Int      @default(0)
  lastSentAt DateTime @map("last_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([phone, actorType], name: "phone_actorType")
  @@index([phone, actorType, expiresAt])
  @@map("auth_otps")
}

model OrderStatusEvent {
  id Int @id @default(autoincrement())

  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status          String
  source          String  @default("SYSTEM")
  changedByUserId Int?    @map("changed_by_user_id")
  changedByName   String? @map("changed_by_name")
  notes           String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("order_status_events")
}

///////////////////////////////////////////////////////////
// RESTAURANT TABLES
///////////////////////////////////////////////////////////

model DiningTable {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableNo String @map("table_no")
  seats   Int    @default(4)

  // FLOOR PLAN LAYOUT PROPERTIES
  section   String? @default("Main Floor")
  positionX Float?  @map("position_x")
  positionY Float?  @map("position_y")
  width     Int?    @default(120)
  height    Int?    @default(100)
  shape     String? @default("RECTANGLE") // RECTANGLE | ROUND | SQUARE
  rotation  Int?    @default(0) // 0 | 90 | 180 | 270

  qrCodeUrl String? @map("qr_code_url")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tableSessions TableSession[]
  reservations  Reservation[]

  @@unique([restaurantId, tableNo])
  @@index([restaurantId, isActive])
  @@index([restaurantId, section])
  @@map("dining_tables")
}

model TableSession {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableId Int         @map("table_id")
  table   DiningTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  tableNo String @map("table_no")

  waiterId   Int?    @map("waiter_id")
  waiterName String? @map("waiter_name")

  guestCount Int @default(1) @map("guest_count")

  // STATUS: OPEN / BILLING / PAID / CLOSED / MERGED / CANCELLED
  status String @default("OPEN")

  subtotal            Float @default(0)
  taxAmount           Float @default(0) @map("tax_amount")
  serviceChargeAmount Float @default(0) @map("service_charge_amount")
  discountAmount      Float @default(0) @map("discount_amount")
  total               Float @default(0)

  mergedIntoSessionId Int?          @map("merged_into_session_id")
  mergedIntoSession   TableSession? @relation("MergedSessions", fields: [mergedIntoSessionId], references: [id], onDelete: SetNull)
  mergedSessions      TableSession[] @relation("MergedSessions")

  openedAt DateTime  @default(now()) @map("opened_at")
  billedAt DateTime? @map("billed_at")
  paidAt   DateTime? @map("paid_at")
  closedAt DateTime? @map("closed_at")

  clientOperationId String? @unique @map("client_operation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  orders Order[]
  kots   KitchenOrderTicket[]
  billSplits BillSplit[]
  payments   Payment[]
  reservations Reservation[]

  @@index([restaurantId, tableId, status])
  @@index([restaurantId, status, createdAt])
  @@map("table_sessions")
}

model TableOperationLog {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  operationType String @map("operation_type") // MOVE_TABLE | MERGE_TABLE | SPLIT_TABLE | ITEM_TRANSFER

  sourceSessionId Int? @map("source_session_id")
  targetSessionId Int? @map("target_session_id")

  sourceTableId Int?    @map("source_table_id")
  sourceTableNo String? @map("source_table_no")

  targetTableId Int?    @map("target_table_id")
  targetTableNo String? @map("target_table_no")

  performedByUserId   Int?    @map("performed_by_user_id")
  performedByName     String? @map("performed_by_name")
  performedByUserRole String? @map("performed_by_user_role")

  details Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([restaurantId, operationType, createdAt])
  @@index([sourceSessionId])
  @@index([targetSessionId])
  @@map("table_operation_logs")
}

model Expense {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  title    String
  category String   @default("General")
  amount   Float
  notes    String?
  spentAt  DateTime @map("spent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([restaurantId, spentAt])
  @@index([restaurantId, createdAt])
  @@map("expenses")
}

///////////////////////////////////////////////////////////
// MULTI-BRANCH
///////////////////////////////////////////////////////////

model Branch {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name     String
  location String?

  latitude  Float?
  longitude Float?

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  users               User[]
  orders              Order[]
  promotions          Promotion[]
  loyaltyAccounts     LoyaltyAccount[]
  loyaltyTransactions LoyaltyTransaction[]

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
  @@map("branches")
}

model Promotion {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  branchId Int?    @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name        String
  description String?
  code        String?

  // PERCENTAGE | FIXED_AMOUNT | ITEM_DISCOUNT | CATEGORY_DISCOUNT | COUPON | AUTOMATIC_OFFER
  type String @default("PERCENTAGE")

  value           Float
  maximumDiscount Float? @map("maximum_discount")

  minimumOrderAmount Float? @default(0) @map("minimum_order_amount")
  minimumQuantity    Int?   @default(0) @map("minimum_quantity")

  eligibleItems      String? @map("eligible_items")
  eligibleCategories String? @map("eligible_categories")
  eligibleOrderTypes String? @map("eligible_order_types")
  eligibleCustomerId Int?    @map("eligible_customer_id")

  startAt DateTime? @map("start_at")
  endAt   DateTime? @map("end_at")

  usageLimit            Int? @map("usage_limit")
  usageLimitPerCustomer Int? @map("usage_limit_per_customer")
  usageCount            Int  @default(0) @map("usage_count")

  active    Boolean @default(true)
  stackable Boolean @default(false)
  priority  Int     @default(0)

  createdById   Int?    @map("created_by_id")
  createdByName String? @map("created_by_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  orders Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId, active])
  @@index([restaurantId, code])
  @@index([restaurantId, startAt, endAt])
  @@map("promotions")
}

///////////////////////////////////////////////////////////
// PAYMENTS
///////////////////////////////////////////////////////////

model Payment {
  id Int @id @default(autoincrement())

  cashfreeOrderId  String? @map("cashfree_order_id")
  paymentSessionId String? @map("payment_session_id")

  customerId   Int?             @map("customer_id")
  customer     CustomerAccount? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  restaurantId Int?             @map("restaurant_id")
  restaurant   Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  orderId      Int?             @map("order_id")
  order        Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  tableSessionId Int?          @map("table_session_id")
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)

  billSplitId Int?        @map("bill_split_id")
  billSplit   BillSplit?  @relation(fields: [billSplitId], references: [id], onDelete: SetNull)

  shiftId Int?          @map("shift_id")
  shift   CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  amount          Float   @default(0)
  amountSubunit   Int?    @map("amount_subunit")
  amountDue       Float?  @map("amount_due")
  amountReceived  Float?  @map("amount_received")
  changeAmount    Float?  @map("change_amount")
  currency        String  @default("INR")

  status          String  @default("PENDING")
  transactionId   String? @map("transaction_id")
  paymentMethod   String? @map("payment_method")
  method          String?
  provider        String? @default("CASHFREE")

  providerOrderId String? @map("provider_order_id")
  providerMetadata Json?  @map("provider_metadata")
  idempotencyKey  String? @unique @map("idempotency_key")
  performedByName String? @map("performed_by_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  cashMovements CashMovement[]

  @@index([restaurantId, createdAt])
  @@index([orderId])
  @@index([tableSessionId])
  @@index([billSplitId])
  @@index([shiftId])
  @@index([cashfreeOrderId])
  @@index([paymentSessionId])
  @@map("payments")
}

model BillSplit {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableSessionId Int?          @map("table_session_id")
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  orderId Int?   @map("order_id")
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  splitNo   Int     @default(1) @map("split_no")
  label     String? @default("Split #1")
  splitType String  @default("ITEM") @map("split_type") // ITEM | QUANTITY | EQUAL | CUSTOM

  subtotal            Float @default(0)
  taxAmount           Float @default(0) @map("tax_amount")
  serviceChargeAmount Float @default(0) @map("service_charge_amount")
  discountAmount      Float @default(0) @map("discount_amount")
  total               Float @default(0)

  paidAmount    Float @default(0) @map("paid_amount")
  pendingAmount Float @default(0) @map("pending_amount")

  status String @default("UNPAID") // UNPAID | PARTIALLY_PAID | PAID

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  items    BillSplitItem[]
  payments Payment[]

  @@index([restaurantId, tableSessionId])
  @@index([restaurantId, status])
  @@map("bill_splits")
}

model BillSplitItem {
  id Int @id @default(autoincrement())

  billSplitId Int       @map("bill_split_id")
  billSplit   BillSplit @relation(fields: [billSplitId], references: [id], onDelete: Cascade)

  orderItemId Int       @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  qty   Int   @default(1)
  price Float @default(0)
  total Float @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([billSplitId])
  @@index([orderItemId])
  @@map("bill_split_items")
}

///////////////////////////////////////////////////////////
// INVENTORY (RESTAURANT-SCOPED)
///////////////////////////////////////////////////////////

model InventoryStock {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItemId Int      @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  stockQuantity  Int @default(0) @map("stock_quantity")
  thresholdAlert Int @default(0) @map("threshold_alert")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, menuItemId])
  @@index([restaurantId])
  @@map("inventory_stocks")
}

model PayLaterAccount {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  totalBorrowed Float @default(0) @map("total_borrowed")
  totalPaid     Float @default(0) @map("total_paid")
  pendingBalance Float @default(0) @map("pending_balance")
  status        String @default("ACTIVE") // ACTIVE, SUSPENDED

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  transactions PayLaterTransaction[]

  @@unique([restaurantId, customerId])
  @@map("pay_later_accounts")
}

model PayLaterTransaction {
  id Int @id @default(autoincrement())

  accountId Int             @map("account_id")
  account   PayLaterAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orderId Int?   @map("order_id")
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  type   String // ORDER_CREDIT, MANUAL_CREDIT, ONLINE_REPAYMENT, OFFLINE_REPAYMENT, ADJUSTMENT
  amount Float
  description String?
  paymentReference String? @map("payment_reference")
  status String @default("SUCCESS") // SUCCESS, PENDING, FAILED

  createdBy String @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("pay_later_transactions")
}

model CustomerNotification {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   Int      @map("customer_id")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title        String
  message      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("customer_notifications")
}

model Notification {
  id               Int       @id @default(autoincrement())
  recipientType    String    @map("recipient_type") // CUSTOMER | USER | RESTAURANT | DELIVERY_PARTNER
  recipientId      Int       @map("recipient_id")
  orderId          Int?      @map("order_id")
  restaurantId     Int?      @map("restaurant_id")
  notificationType String    @map("notification_type")
  title            String
  message          String
  data             Json?
  channel          String    @default("IN_APP")
  priority         String    @default("NORMAL")
  isRead           Boolean   @default(false) @map("is_read")
  idempotencyKey   String?   @unique @map("idempotency_key")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([recipientType, recipientId, isRead])
  @@index([orderId])
  @@index([restaurantId])
  @@map("notifications")
}

model DeviceToken {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  customerId  Int?     @map("customer_id")
  deviceToken String   @map("device_token")
  platform    String   @default("ANDROID") // ANDROID | IOS | WEB
  deviceId    String?  @map("device_id")
  isActive    Boolean  @default(true) @map("is_active")
  lastUsedAt  DateTime @default(now()) @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([deviceToken])
  @@index([userId, isActive])
  @@index([customerId, isActive])
  @@map("device_tokens")
}

model NotificationPreference {
  id              Int      @id @default(autoincrement())
  userId          Int?     @unique @map("user_id")
  customerId      Int?     @unique @map("customer_id")
  orderUpdates    Boolean  @default(true) @map("order_updates")
  paymentUpdates  Boolean  @default(true) @map("payment_updates")
  deliveryUpdates Boolean  @default(true) @map("delivery_updates")
  promotions      Boolean  @default(true)
  coupons         Boolean  @default(true)
  reviewReminders Boolean  @default(true) @map("review_reminders")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model GlobalCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  imageUrl  String?  @map("image_url")
  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("global_categories")
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String?
  imageUrl  String   @map("image_url")
  actionUrl String?  @map("action_url")
  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("banners")
}

///////////////////////////////////////////////////////////
// TIFFZY CUSTOMER WALLET SYSTEM
///////////////////////////////////////////////////////////

model Wallet {
  id                Int             @id @default(autoincrement())
  customerAccountId Int             @unique @map("customer_account_id")
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  currency          String          @default("INR")
  balance           Float           @default(0)
  status            String          @default("ACTIVE") // ACTIVE | BLOCKED | CLOSED

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  ledgers           WalletLedger[]
  topups            WalletTopup[]

  @@map("wallets")
}

model WalletLedger {
  id                Int          @id @default(autoincrement())
  walletId          Int          @map("wallet_id")
  wallet            Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)

  customerAccountId Int          @map("customer_account_id")

  type              String       // WALLET_TOPUP | ORDER_PAYMENT | REFUND | REVERSAL | ADJUSTMENT_CREDIT | ADJUSTMENT_DEBIT
  direction         String       // CREDIT | DEBIT
  amount            Float
  balanceBefore     Float        @map("balance_before")
  balanceAfter      Float        @map("balance_after")

  referenceType     String?      @map("reference_type") // ORDER | TOPUP | REFUND | ADMIN
  referenceId       String?      @map("reference_id")
  paymentId         Int?         @map("payment_id")
  orderId           Int?         @map("order_id")

  description       String
  idempotencyKey    String?      @unique @map("idempotency_key")
  status            String       @default("SUCCESS")
  metadata          Json?

  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([walletId, createdAt])
  @@index([customerAccountId, createdAt])
  @@index([orderId])
  @@map("wallet_ledgers")
}

model WalletTopup {
  id                Int             @id @default(autoincrement())
  walletId          Int             @map("wallet_id")
  wallet            Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  customerAccountId Int             @map("customer_account_id")
  topupTxnId        String          @unique @map("topup_txn_id")

  amount            Float
  currency          String          @default("INR")

  gateway           String          @default("CASHFREE")
  gatewayOrderId    String?         @map("gateway_order_id")
  gatewayPaymentId  String?         @map("gateway_payment_id")

  status            String          @default("PENDING") // PENDING | SUCCESS | FAILED | CANCELLED
  idempotencyKey    String?         @unique @map("idempotency_key")

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([walletId, createdAt])
  @@index([customerAccountId])
  @@map("wallet_topups")
}

///////////////////////////////////////////////////////////
// TIFFZY SUPPLY CHAIN MARKETPLACE MODELS
///////////////////////////////////////////////////////////

model Supplier {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  phone        String   @unique
  passwordHash String   @map("password_hash")
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED | BLOCKED | ACTIVE
  isVerified   Boolean  @default(false) @map("is_verified")
  sessionVersion Int    @default(0) @map("session_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  profile      SupplierProfile?
  addresses    SupplierAddress[]
  products     SupplyProduct[]
  orders       SupplyOrder[]
  settlements  SupplierSettlement[]
  reviews      SupplyReview[]

  @@index([status, createdAt])
  @@index([phone])
  @@map("suppliers")
}

model SupplierProfile {
  id               Int      @id @default(autoincrement())
  supplierId       Int      @unique @map("supplier_id")
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  businessName     String   @map("business_name")
  legalName        String?  @map("legal_name")
  gstin            String?  @unique
  fssaiLicense     String?  @map("fssai_license")
  logoUrl          String?  @map("logo_url")
  bannerUrl        String?  @map("banner_url")
  description      String?
  rating           Float    @default(4.8)
  reviewCount      Int      @default(0) @map("review_count")

  // BANK & SETTLEMENT PAYOUT DETAILS
  bankAccountNumber String? @map("bank_account_number")
  bankIfscCode      String? @map("bank_ifsc_code")
  bankAccountName   String? @map("bank_account_name")
  bankName          String? @map("bank_name")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("supplier_profiles")
}

model SupplierAddress {
  id          Int      @id @default(autoincrement())
  supplierId  Int      @map("supplier_id")
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  label       String   @default("Warehouse") // Main Warehouse, Branch Pick-up
  line1       String   @map("address_line1")
  line2       String?  @map("address_line2")
  city        String
  state       String
  pincode     String   @map("postal_code")
  country     String   @default("India")
  latitude    Float?
  longitude   Float?
  isPrimary   Boolean  @default(true) @map("is_primary")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([supplierId, isPrimary])
  @@map("supplier_addresses")
}

model SupplyCategory {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  slug      String          @unique
  imageUrl  String?         @map("image_url")
  isActive  Boolean         @default(true) @map("is_active")
  priority  Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at")

  products  SupplyProduct[]

  @@map("supply_categories")
}

model SupplyProduct {
  id           Int            @id @default(autoincrement())
  supplierId   Int            @map("supplier_id")
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  categoryId   Int?           @map("category_id")
  category     SupplyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name         String
  slug         String         @unique
  description  String?
  unit         String         @default("KG") // KG, GRAM, LITER, PACK, PIECE, BOX
  moq          Float          @default(1)    // Minimum Order Quantity
  availability Boolean        @default(true) @map("is_available")
  status       String         @default("PENDING") // PENDING | APPROVED | REJECTED | DISABLED
  isDeleted    Boolean        @default(false) @map("is_deleted")

  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")

  images       SupplyProductImage[]
  prices       SupplyPrice[]
  discounts    SupplyDiscount[]
  inventory    SupplyInventory?
  cartItems    SupplyCartItem[]
  orderItems   SupplyOrderItem[]
  reviews      SupplyReview[]

  @@index([supplierId, status, isDeleted])
  @@index([categoryId, availability, status])
  @@map("supply_products")
}

model SupplyProductImage {
  id        Int           @id @default(autoincrement())
  productId Int           @map("product_id")
  product   SupplyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageUrl  String        @map("image_url")
  priority  Int           @default(0)
  isPrimary Boolean       @default(false) @map("is_primary")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([productId, isPrimary])
  @@map("supply_product_images")
}

model SupplyPrice {
  id        Int           @id @default(autoincrement())
  productId Int           @map("product_id")
  product   SupplyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  basePrice Float         @map("base_price") // Cost before discount & tax
  taxPercent Float        @default(5.0) @map("tax_percent")
  currency  String        @default("INR")
  isActive  Boolean       @default(true) @map("is_active")

  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([productId, isActive])
  @@map("supply_prices")
}

model SupplyDiscount {
  id           Int           @id @default(autoincrement())
  productId    Int           @map("product_id")
  product      SupplyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  type         String        @default("PERCENTAGE") // PERCENTAGE | FIXED
  value        Float         // e.g. 8.0 for 8% or 20.0 for ₹20
  startDate    DateTime?     @map("start_date")
  endDate      DateTime?     @map("end_date")
  isActive     Boolean       @default(true) @map("is_active")

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([productId, isActive])
  @@map("supply_discounts")
}

model SupplyInventory {
  id             Int           @id @default(autoincrement())
  productId      Int           @unique @map("product_id")
  product        SupplyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  totalStock     Float         @default(0) @map("total_stock")
  reservedStock  Float         @default(0) @map("reserved_stock")
  availableStock Float         @default(0) @map("available_stock") // available_stock = total_stock - reserved_stock
  lowStockAlert  Float         @default(10) @map("low_stock_alert")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  transactions   SupplyInventoryTransaction[]
  batches        SupplyInventoryBatch[]

  @@map("supply_inventories")
}

model SupplyInventoryTransaction {
  id            Int             @id @default(autoincrement())
  inventoryId   Int             @map("inventory_id")
  inventory     SupplyInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  type          String          // STOCK_ADD | STOCK_RESERVE | STOCK_RELEASE | STOCK_CONSUMED | STOCK_ADJUSTMENT
  quantity      Float
  balanceBefore Float           @map("balance_before")
  balanceAfter  Float           @map("balance_after")

  referenceType String?         @map("reference_type") // SUPPLY_ORDER | SUPPLIER_ADJUSTMENT | SYSTEM
  referenceId   String?         @map("reference_id")
  notes         String?

  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([inventoryId, createdAt])
  @@map("supply_inventory_transactions")
}

model SupplyInventoryBatch {
  id              Int             @id @default(autoincrement())
  inventoryId     Int             @map("inventory_id")
  inventory       SupplyInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  batchNumber     String          @map("batch_number")
  quantity        Float
  costPrice       Float?          @map("cost_price")
  manufactureDate DateTime?       @map("manufacture_date")
  expiryDate      DateTime?       @map("expiry_date")

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")

  @@index([inventoryId, batchNumber])
  @@map("supply_inventory_batches")
}

model SupplyCart {
  id           Int              @id @default(autoincrement())
  restaurantId Int              @unique @map("restaurant_id")
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at")

  items        SupplyCartItem[]

  @@map("supply_carts")
}

model SupplyCartItem {
  id         Int           @id @default(autoincrement())
  cartId     Int           @map("cart_id")
  cart       SupplyCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId  Int           @map("product_id")
  product    SupplyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity   Float
  unitPrice  Float         @map("unit_price")
  discount   Float         @default(0)
  finalPrice Float         @map("final_price")

  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at")

  @@unique([cartId, productId])
  @@map("supply_cart_items")
}

model SupplyOrder {
  id              Int        @id @default(autoincrement())
  orderNo         String     @unique @map("order_no")

  restaurantId    Int        @map("restaurant_id")
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  supplierId      Int        @map("supplier_id")
  supplier        Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // BILLING
  subtotal        Float
  discountAmount  Float      @default(0) @map("discount_amount")
  taxAmount       Float      @default(0) @map("tax_amount")
  deliveryFee     Float      @default(0) @map("delivery_fee")
  totalAmount     Float      @map("total_amount")

  // STATUS
  status          String     @default("PLACED")
  // PLACED / ACCEPTED / PROCESSING / READY / DISPATCHED / DELIVERED / COMPLETED / CANCELLED / REJECTED

  paymentStatus   String     @default("PENDING") @map("payment_status") // PENDING | PAID | FAILED | REFUNDED
  paymentMode     String?    @map("payment_mode") // ONLINE | CASH_ON_DELIVERY | CREDIT

  notes           String?
  deliveryAddress String?    @map("delivery_address")

  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at")

  items           SupplyOrderItem[]
  statusEvents    SupplyOrderStatusEvent[]
  payments        SupplyPayment[]
  refunds         SupplyRefund[]
  settlementItem  SupplierSettlementItem?

  @@index([restaurantId, createdAt])
  @@index([supplierId, status, createdAt])
  @@map("supply_orders")
}

model SupplyOrderItem {
  id         Int           @id @default(autoincrement())
  orderId    Int           @map("order_id")
  order      SupplyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId  Int?          @map("product_id")
  product    SupplyProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String       @map("product_name")
  unit        String
  quantity    Float
  unitPrice   Float        @map("unit_price")
  discount    Float        @default(0)
  totalPrice  Float        @map("total_price")

  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("supply_order_items")
}

model SupplyOrderStatusEvent {
  id          Int         @id @default(autoincrement())
  orderId     Int         @map("order_id")
  order       SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status      String
  notes       String?
  createdRole String?     @map("created_role")
  createdBy   String?     @map("created_by")

  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("supply_order_status_events")
}

model SupplyPayment {
  id               Int         @id @default(autoincrement())
  orderId          Int         @map("order_id")
  order            SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  gatewayTxnId     String?     @map("gateway_txn_id")
  paymentSessionId String?     @map("payment_session_id")
  amount           Float
  currency         String      @default("INR")
  status           String      @default("PENDING") // PENDING | SUCCESS | FAILED | CANCELLED
  provider         String      @default("CASHFREE")
  metadata         Json?

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([gatewayTxnId])
  @@map("supply_payments")
}

model SupplyRefund {
  id           Int         @id @default(autoincrement())
  orderId      Int         @map("order_id")
  order        SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  refundTxnId  String      @unique @map("refund_txn_id")
  amount       Float
  reason       String?
  status       String      @default("PENDING") // PENDING | COMPLETED | FAILED

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("supply_refunds")
}

model SupplierSettlement {
  id              Int                      @id @default(autoincrement())
  settlementNo    String                   @unique @map("settlement_no")

  supplierId      Int                      @map("supplier_id")
  supplier        Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  grossAmount     Float                    @map("gross_amount")
  commissionFee   Float                    @default(0) @map("commission_fee")
  taxDeductions   Float                    @default(0) @map("tax_deductions")
  netPayable      Float                    @map("net_payable")

  status          String                   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  payoutRef       String?                  @map("payout_ref")
  settledAt       DateTime?                @map("settled_at")

  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at")

  items           SupplierSettlementItem[]

  @@index([supplierId, status, createdAt])
  @@map("supplier_settlements")
}

model SupplierSettlementItem {
  id           Int                @id @default(autoincrement())
  settlementId Int                @map("settlement_id")
  settlement   SupplierSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  orderId      Int                @unique @map("order_id")
  order        SupplyOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderAmount  Float              @map("order_amount")
  commission   Float              @map("commission")
  netAmount    Float              @map("net_amount")

  createdAt    DateTime           @default(now()) @map("created_at")

  @@map("supplier_settlement_items")
}

model SupplyReview {
  id          Int           @id @default(autoincrement())
  supplierId  Int           @map("supplier_id")
  supplier    Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  productId   Int?          @map("product_id")
  product     SupplyProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  restaurantId Int          @map("restaurant_id")

  rating      Float         // 1.0 - 5.0
  comment     String?

  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([supplierId, rating])
  @@index([productId, rating])
  @@map("supply_reviews")
}

model SupplyAnalyticsEvent {
  id          Int      @id @default(autoincrement())
  eventType   String   @map("event_type") // PRODUCT_VIEW | CART_ADD | ORDER_PLACED | SUPPLIER_IMPRESSION
  actorType   String   @map("actor_type") // RESTAURANT | SUPPLIER | GUEST
  actorId     Int?     @map("actor_id")
  targetId    Int?     @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([actorType, actorId])
  @@map("supply_analytics_events")
}

///////////////////////////////////////////////////////////
// PRINTERS & KITCHEN STATIONS
///////////////////////////////////////////////////////////

model Printer {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name             String
  connectionType   String  @default("NETWORK") @map("connection_type") // NETWORK / ESC_POS_DIRECT
  ipAddress        String? @map("ip_address")
  port             Int     @default(9100)
  paperWidth       String  @default("80mm") @map("paper_width") // 58mm / 80mm
  isBillingPrinter Boolean @default(false) @map("is_billing_printer")
  isDefault        Boolean @default(false) @map("is_default")
  isActive         Boolean @default(true) @map("is_active")

  stations KitchenStation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([restaurantId, isActive])
  @@map("printers")
}

model KitchenStation {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  code        String?
  description String?
  isDefault   Boolean @default(false) @map("is_default")
  isActive    Boolean @default(true) @map("is_active")

  printerId Int?     @map("printer_id")
  printer   Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)

  menuItems MenuItem[]
  kots      KitchenOrderTicket[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, name])
  @@index([restaurantId, isActive])
  @@map("kitchen_stations")
}

model KitchenOrderTicket {
  id Int @id @default(autoincrement())

  kotNo          String @map("kot_no")
  sequenceNumber Int    @map("sequence_number")

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableSessionId Int?          @map("table_session_id")
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)

  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stationId Int?            @map("station_id")
  station   KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  stationName String? @map("station_name")
  tableNo     String? @map("table_no")

  waiterId   Int?    @map("waiter_id")
  waiterName String? @map("waiter_name")

  // TYPE: NEW / MODIFICATION / CANCELLATION
  type String @default("NEW")

  // STATUS: PENDING / PRINTED / PRINT_FAILED / PREPARING / READY / SERVED / CANCELLED
  status String @default("PENDING")

  printed      Boolean   @default(false)
  printedAt    DateTime? @map("printed_at")
  printError   String?   @map("print_error")
  reprintCount Int       @default(0) @map("reprint_count")

  notes          String?
  idempotencyKey String? @unique @map("idempotency_key")
  clientOperationId String? @unique @map("client_operation_id")

  items KitchenOrderTicketItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, kotNo])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, tableSessionId])
  @@index([restaurantId, orderId])
  @@index([restaurantId, stationId])
  @@map("kitchen_order_tickets")
}

model KitchenOrderTicketItem {
  id Int @id @default(autoincrement())

  kotId Int                @map("kot_id")
  kot   KitchenOrderTicket @relation(fields: [kotId], references: [id], onDelete: Cascade)

  orderItemId Int?   @map("order_item_id")
  menuItemId  Int?   @map("menu_item_id")
  itemName    String @map("item_name")

  variantId         Int?    @map("variant_id")
  variantName       String? @map("variant_name")
  variantPrice      Float?  @map("variant_price")
  selectedModifiers Json?   @map("selected_modifiers")
  notes             String?

  qty    Int    @map("quantity")
  status String @default("PENDING")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("kitchen_order_ticket_items")
}

///////////////////////////////////////////////////////////
// TABLE RESERVATIONS
///////////////////////////////////////////////////////////

model Reservation {
  id Int @id @default(autoincrement())

  reservationNo String @map("reservation_no")

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableId Int?         @map("table_id")
  table   DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  customerId Int?      @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  tableSessionId Int?          @map("table_session_id")
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)

  reservationDate DateTime @map("reservation_date")
  startTime       String   @map("start_time")
  endTime         String   @map("end_time")
  guestCount      Int      @default(1) @map("guest_count")
  actualGuests    Int?     @map("actual_guests")

  customerName  String  @map("customer_name")
  customerPhone String  @map("customer_phone")
  customerEmail String? @map("customer_email")
  notes         String?

  // PENDING | CONFIRMED | CHECKED_IN | SEATED | COMPLETED | CANCELLED | NO_SHOW
  status String @default("CONFIRMED")

  source String? @default("POS")

  createdById   Int?    @map("created_by_id")
  createdByName String? @map("created_by_name")

  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  cancelReason String?   @map("cancel_reason")

  checkedInAt DateTime? @map("checked_in_at")
  seatedAt    DateTime? @map("seated_at")
  completedAt DateTime? @map("completed_at")

  clientOperationId String? @unique @map("client_operation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, reservationNo])
  @@index([restaurantId, reservationDate])
  @@index([restaurantId, tableId, reservationDate])
  @@index([restaurantId, customerId])
  @@index([restaurantId, status])
  @@map("reservations")
}

///////////////////////////////////////////////////////////
// RAW MATERIAL INVENTORY & RECIPE BOM
///////////////////////////////////////////////////////////

model RawMaterial {
  id              Int               @id @default(autoincrement())
  restaurantId    Int               @map("restaurant_id")
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name            String
  code            String?           // SKU / Barcode
  category        String            @default("General") // Produce, Meat, Dairy, Dry Goods, Beverages, Spices, Packaging

  // Base Unit for internal calculations: "g", "ml", "pcs"
  baseUnit        String            @map("base_unit")

  // Display Unit for UI friendliness: "kg", "g", "L", "ml", "pcs", "dozen"
  displayUnit     String?           @map("display_unit")

  currentStock    Float             @default(0) @map("current_stock") // Stored in baseUnit
  minimumStock    Float             @default(0) @map("minimum_stock") // Reorder threshold in baseUnit

  costPerBaseUnit Float             @default(0) @map("cost_per_base_unit") // Cost per base unit

  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")

  recipeItems     RecipeItem[]
  movements       StockMovement[]

  @@unique([restaurantId, name])
  @@index([restaurantId, category, isActive])
  @@map("raw_materials")
}

model Recipe {
  id              Int               @id @default(autoincrement())
  restaurantId    Int               @map("restaurant_id")
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItemId      Int?              @map("menu_item_id")
  menuItem        MenuItem?         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  variantId       Int?              @map("variant_id")
  variant         MenuItemVariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  modifierId      Int?              @map("modifier_id")
  modifier        MenuItemModifier? @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  name            String?
  version         Int               @default(1)
  isActive        Boolean           @default(true) @map("is_active")

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")

  items           RecipeItem[]

  @@index([restaurantId, menuItemId, isActive])
  @@index([restaurantId, variantId, isActive])
  @@index([restaurantId, modifierId, isActive])
  @@map("recipes")
}

model RecipeItem {
  id              Int               @id @default(autoincrement())
  recipeId        Int               @map("recipe_id")
  recipe          Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  rawMaterialId   Int               @map("raw_material_id")
  rawMaterial     RawMaterial       @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  quantity        Float
  unit            String            // "g", "kg", "ml", "L", "pcs", etc.
  baseQuantity    Float             @map("base_quantity") // Converted to rawMaterial.baseUnit

  wastagePercent  Float             @default(0) @map("wastage_percent")

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")

  @@index([recipeId])
  @@index([rawMaterialId])
  @@map("recipe_items")
}

model StockMovement {
  id              Int               @id @default(autoincrement())
  restaurantId    Int               @map("restaurant_id")
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  rawMaterialId   Int               @map("raw_material_id")
  rawMaterial     RawMaterial       @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  movementType    String            @map("movement_type") // OPENING | PURCHASE | SALE | WASTAGE | ADJUSTMENT_IN | ADJUSTMENT_OUT | REVERSAL

  quantity        Float             // Signed quantity change in baseUnit (+10000 for 10kg stock-in, -250 for 250g sale)
  unitCost        Float             @default(0) @map("unit_cost")
  totalCost       Float             @default(0) @map("total_cost")

  balanceAfter    Float             @map("balance_after") // Stock balance in baseUnit after movement

  sourceType      String            @map("source_type") // ORDER | PURCHASE | WASTAGE | ADJUSTMENT | OPENING | REVERSAL
  sourceId        String?           @map("source_id")

  orderItemId     Int?              @map("order_item_id")
  orderItem       OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  notes           String?
  performedById   Int?              @map("performed_by_id")
  performedByName String?           @map("performed_by_name")

  idempotencyKey  String?           @unique @map("idempotency_key")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([restaurantId, rawMaterialId, createdAt])
  @@index([restaurantId, movementType, createdAt])
  @@index([sourceType, sourceId])
  @@map("stock_movements")
}

///////////////////////////////////////////////////////////
// CASHIER SHIFTS & DAY CLOSING
///////////////////////////////////////////////////////////

model CashierShift {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  userId Int  @map("user_id")
  user   User @relation("OpenedShifts", fields: [userId], references: [id], onDelete: Cascade)

  closedByUserId Int?  @map("closed_by_user_id")
  closedByUser   User? @relation("ClosedShifts", fields: [closedByUserId], references: [id], onDelete: SetNull)

  approvedByUserId Int?  @map("approved_by_user_id")
  approvedByUser   User? @relation("ApprovedShifts", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  terminalId String @default("MAIN") @map("terminal_id")

  // OPEN | CLOSING | CLOSED | CANCELLED
  status String @default("OPEN")

  businessDate DateTime @map("business_date")

  openedAt DateTime  @default(now()) @map("opened_at")
  closedAt DateTime? @map("closed_at")

  openingCash Float @default(0) @map("opening_cash")
  expectedCash Float @default(0) @map("expected_cash")
  actualCash   Float? @map("actual_cash")
  variance     Float?
  varianceReason String? @map("variance_reason")
  notes        String?
  managerApproved Boolean @default(true) @map("manager_approved")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  cashMovements CashMovement[]
  payments      Payment[]

  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, userId, status])
  @@index([restaurantId, businessDate])
  @@index([restaurantId, terminalId, status])
  @@map("cashier_shifts")
}

model CashMovement {
  id Int @id @default(autoincrement())

  shiftId Int          @map("shift_id")
  shift   CashierShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // OPENING_CASH | CASH_SALE | CASH_REFUND | CASH_IN | CASH_OUT | CLOSING_ADJUSTMENT
  type String

  amount Float
  reason String?

  paymentId Int?     @map("payment_id")
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  performedByUserId Int    @map("performed_by_user_id")
  performedByName   String? @map("performed_by_name")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([shiftId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([type])
  @@map("cash_movements")
}

model DayClosing {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  businessDate DateTime @map("business_date")

  // OPEN | CLOSING | CLOSED
  status String @default("OPEN")

  grossSales          Float @default(0) @map("gross_sales")
  discountAmount      Float @default(0) @map("discount_amount")
  taxAmount           Float @default(0) @map("tax_amount")
  serviceChargeAmount Float @default(0) @map("service_charge_amount")
  refundAmount        Float @default(0) @map("refund_amount")
  netSales            Float @default(0) @map("net_sales")

  cashTotal     Float @default(0) @map("cash_total")
  upiTotal      Float @default(0) @map("upi_total")
  cardTotal     Float @default(0) @map("card_total")
  cashfreeTotal Float @default(0) @map("cashfree_total")
  payLaterTotal Float @default(0) @map("pay_later_total")
  otherTotal    Float @default(0) @map("other_total")

  totalOrders     Int @default(0) @map("total_orders")
  cancelledOrders Int @default(0) @map("cancelled_orders")
  kotCount        Int @default(0) @map("kot_count")

  totalShifts       Int   @default(0) @map("total_shifts")
  totalCashVariance Float @default(0) @map("total_cash_variance")

  notes String?

  closedAt       DateTime? @map("closed_at")
  closedByUserId Int?      @map("closed_by_user_id")
  closedByUser   User?     @relation("ClosedDayClosings", fields: [closedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([restaurantId, businessDate])
  @@index([restaurantId, status])
  @@map("day_closings")
}

// ==========================================
// FEATURE 14: LOYALTY POINTS & REWARDS MODELS
// ==========================================

model LoyaltyAccount {
  id Int @id @default(autoincrement())

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  branchId Int?    @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  currentBalance   Int @default(0) @map("current_balance")
  lifetimeEarned   Int @default(0) @map("lifetime_earned")
  lifetimeRedeemed Int @default(0) @map("lifetime_redeemed")

  // ACTIVE | SUSPENDED | CLOSED
  status String @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  transactions LoyaltyTransaction[]

  @@unique([restaurantId, customerId])
  @@index([restaurantId, customerId])
  @@index([restaurantId, status])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id Int @id @default(autoincrement())

  loyaltyAccountId Int            @map("loyalty_account_id")
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  restaurantId Int        @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  branchId Int?    @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // EARN | REDEEM | REFUND_REVERSAL | CANCELLATION_REVERSAL | REDEMPTION_REVERSAL | EXPIRY | MANUAL_CREDIT | MANUAL_DEBIT | ADJUSTMENT
  type String

  points        Int
  balanceBefore Int @map("balance_before")
  balanceAfter  Int @map("balance_after")

  orderId Int?   @map("order_id")
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  referenceId String?   @map("reference_id")
  description String?
  expiresAt   DateTime? @map("expires_at")

  createdById   Int?    @map("created_by_id")
  createdByName String? @map("created_by_name")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([restaurantId, orderId, type])
  @@index([restaurantId, customerId])
  @@index([loyaltyAccountId, createdAt])
  @@index([restaurantId, type])
  @@index([orderId, type])
  @@map("loyalty_transactions")
}

model LoyaltyConfig {
  id Int @id @default(autoincrement())

  restaurantId Int        @unique @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  // E.g., 0.1 means 0.1 points earned per ₹1 spent (10 points per ₹100)
  pointsPerCurrency Float @default(0.1) @map("points_per_currency")

  // E.g., 0.1 means 10 points = ₹1 redemption value (₹0.10 per point)
  currencyPerPoint Float @default(0.1) @map("currency_per_point")

  minOrderSubtotalForEarn Float @default(0) @map("min_order_subtotal_for_earn")
  minPointsToRedeem       Int   @default(100) @map("min_points_to_redeem")

  // E.g., Max 20% of order subtotal can be paid with loyalty points
  maxRedeemablePercent Float @default(20) @map("max_redeemable_percent")

  // Allow combining loyalty redemption with active coupon codes
  allowCouponStacking Boolean @default(false) @map("allow_coupon_stacking")

  expiryEnabled Boolean @default(false) @map("expiry_enabled")
  expiryDays    Int     @default(365) @map("expiry_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("loyalty_configs")
}





