{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "nodemon src/server.js",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:setup": "prisma db push --force-reset && prisma db seed",
    "db:update-geo": "node prisma/update-geo.js",
    "postinstall": "prisma generate",
    "prestart": "prisma generate",
    "start": "node src/server.js",
    "test": "node --test src/tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "cashfree-pg": "^6.0.4",
    "cloudinary": "^2.9.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.29.1",
    "mime-types": "^3.0.2",
    "multer": "^2.1.1",
    "pdfkit": "^0.15.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^5.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
