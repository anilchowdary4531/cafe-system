{
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ] && [ \"${ALLOW_VERCEL_PRODUCTION_DEPLOY:-false}\" != \"true\" ] && ! echo \"${VERCEL_GIT_COMMIT_MESSAGE:-}\" | grep -qF \"[deploy prod]\"; then exit 0; else exit 1; fi",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "has": [{ "type": "host", "value": "tiffzy.com" }],
      "destination": "https://api.tiffzy.com/$1"
    },
    {
      "source": "/api/(.*)",
      "has": [{ "type": "host", "value": "www.tiffzy.com" }],
      "destination": "https://api.tiffzy.com/$1"
    },
    {
      "source": "/api/(.*)",
      "has": [{ "type": "host", "value": "cafe-system-nu.vercel.app" }],
      "destination": "https://api.tiffzy.com/$1"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}
