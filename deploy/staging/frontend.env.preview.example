# Vercel Environment Variables -> Scope: **Preview** ONLY (do NOT set in Production)
# Configure both VITE_API_URL and VITE_API_BASE_URL to the staging backend origin
# so Vite never falls back to `/api` (which frontend/vercel.json rewrites to api.tiffzy.com).

VITE_API_URL=https://staging-api.tiffzy.com
VITE_API_BASE_URL=https://staging-api.tiffzy.com
VITE_SOCKET_URL=https://staging-api.tiffzy.com
VITE_CASHFREE_ENV=SANDBOX

