# Isolated Tiffzy Staging Backend Environment Template (Placeholders Only)
# Store on staging server at: /home/ubuntu/cafe-system-staging/backend/.env
# NEVER point DATABASE_URL, JWT_SECRET, or TWM/Cashfree URLs at production!

NODE_ENV=production
APP_ENV=staging
HOST=127.0.0.1
PORT=3100

# Dedicated staging PostgreSQL database (isolated from production RDS)
DATABASE_URL=postgresql://tiffzy_staging:<STAGING_DB_PASSWORD>@<STAGING_DB_HOST>:5432/tiffzy_staging?schema=public

# Separate staging JWT secret (never reuse production JWT_SECRET)
JWT_SECRET=<REPLACE_WITH_UNIQUE_64_CHAR_HEX_STAGING_SECRET>

# Primary Vercel Preview URL & dynamic Vercel Preview CORS allowlist
FRONTEND_URL=https://cafe-system-git-feature-twm-p-ebc5a0-anilchowdary4531s-projects.vercel.app
CORS_ORIGINS=https://cafe-system-git-feature-twm-p-ebc5a0-anilchowdary4531s-projects.vercel.app,http://localhost:5173
CORS_ORIGIN_PATTERNS=https://cafe-system-*.vercel.app

# Public staging API origin (used to compute notify_url)
BACKEND_URL=https://staging-api.tiffzy.com

# Cashfree Sandbox Configuration
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_ENV=SANDBOX
CASHFREE_CLIENT_ID=<CASHFREE_SANDBOX_CLIENT_ID>
CASHFREE_CLIENT_SECRET=<CASHFREE_SANDBOX_SECRET>

# TWM Pay Staging Configuration (never expose to frontend)
# Note: TWM Pay portal (pay.thewebsitemakers.in) requires the site/return domain
# to be added under TWM Pay Admin -> Allowed websites.
TWM_ENABLED=true
TWM_MERCHANT_ID=<TWM_MERCHANT_ID>
TWM_API_SECRET=<TWM_API_SECRET>
TWM_SIGNING_KEY=<TWM_SIGNING_KEY>
TWM_URL=https://pay.thewebsitemakers.in
TWM_TIMEOUT_MS=15000
TWM_NOTIFY_URL=https://staging-api.tiffzy.com/api/payments/twm/notify
TWM_RETURN_URL=

